/* ── 最近项目菜单项 ──────────────────────────────────── */

#RecentMenuItem {
    background-color: transparent;
}
#RecentMenuItem:hover {
    background-color: palette(Highlight);
}

#RecentMenuItemName {
    font-weight: bold;
}

#RecentMenuItemPath {
    color: gray;
    font-size: 11px;
}

QSplitter#fm_splitter {
    background-color: transparent;
}

QSplitter#fm_splitter::handle {
    background-color: #d0d0d0;
    width: 4px;
}
QSplitter#fm_splitter::handle:hover {
    background-color: #a0a0a0;
}
