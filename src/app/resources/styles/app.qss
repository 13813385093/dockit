QToolButton {
    border: none;
}

/* ── 最近项目菜单项 ──────────────────────────────────── */

#RecentMenuItem {
    background-color: transparent;
}
#RecentMenuItem:hover {
    background-color: palette(Highlight);
}

#RecentMenuItemName {
    font-weight: bold;
}

#RecentMenuItemPath {
    color: gray;
    font-size: 11px;
}

#RecentMenuItemBtn {
    background-color: transparent;
    border: none;
}

QSplitter#fm_splitter {
    background-color: transparent;
}

QSplitter#fm_splitter::handle {
    background-color: #E0E0E0;
    width: 0;
}

QSplitter#body_splitter {
    background-color: transparent;
}

QSplitter#body_splitter::handle {
    background-color: transparent;
    border-left-width: 1px;
}

/* ── 格式工具栏按钮 ────────────────────────────────── */

QToolButton[class="toolbar-btn"] {
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px 8px;
    background-color: transparent;
}
QToolButton[class="toolbar-btn"]:hover {
    background-color: #E8E8E8;
    border-color: #CCCCCC;
}
QToolButton[class="toolbar-btn"]:pressed {
    background-color: #D0D0D0;
    border-color: #AAAAAA;
}

/* ── 依赖图面板 ─────────────────────────────────────── */

#DepGraphTitle {
    font-size: 14px;
    font-weight: bold;
}

#DepGraphHint {
    font-size: 12px;
    color: #666666;
}

